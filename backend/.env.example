# ==============================================================================
# Backend Local Environment Variables Template
# Copy this file to .env and fill in your local values.
# IMPORTANT: .env is in .gitignore — NEVER commit secrets or real credentials.
# ==============================================================================

# Database Configuration (MySQL)
# Default DB: clothing_shop_db, User: shop (or your local MySQL username)
DB_PASSWORD=

# JWT Authentication
# Must be at least 32 characters (256 bits) for HMAC-SHA256
JWT_SECRET=

# Development Database Seeder & Local Admin Bootstrap
# Keep 'false' by default. Set to 'true' only on a clean/empty local database to seed data.
SEED_DEV_ENABLED=false
# Admin account credentials (each developer specifies their own email and strong password)
SEED_ADMIN_EMAIL=admin@closet.com
SEED_ADMIN_PASSWORD=

# CORS Configuration (optional, default http://localhost:5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Docker Compose environment variables (if running MySQL via docker-compose)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# MYSQL_HOST_PORT=3307

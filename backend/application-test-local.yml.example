# ─── Application Test Local (template) ─────────────────────────────────────────
# Copy this file to application-test-local.yml and fill in your test values.
# application-test-local.yml is listed in .gitignore and must NEVER be committed.
#
# Profile 'test' connects exclusively to clothing_shop_test.
# Values can also be supplied via environment variables:
#   TEST_DB_URL, TEST_DB_USERNAME, TEST_DB_PASSWORD, JWT_SECRET

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/clothing_shop_test?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
    username: shop
    password: 'your_test_db_password_here'
    driver-class-name: com.mysql.cj.jdbc.Driver

app:
  jwt:
    # JWT_SECRET: minimum 64 random bytes encoded as hex (128 hex chars)
    secret: 'your_128_hex_char_jwt_secret_here'
